{
	"name": "p2pshare-signaling",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"workers_dev": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "Room"
			},
			{
				"name": "DIAGNOSTICS_QUOTA",
				"class_name": "DiagnosticsQuota"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"DiagnosticsQuota"
			]
		}
	],
	"keep_vars": true,
	"observability": {
		"enabled": false
	}
}
